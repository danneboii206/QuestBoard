<!-- Boiler plate -->
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Scripts you wanna load in the beginning, meta information, & stylesheets etc -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Oldenburg&family=Overlock:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&display=swap');
    </style>
    <link rel="stylesheet" href="/style/stylesheet.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuestBoard</title>
</head>
<body>
    <!-- Everything else. New headers, paragraphs, divs, images, etc. Also scripts for functionality -->
    <nav class="navBar">
        <label>QuestBoard</label>
        <ul>
            <% if(userID != -1) { %>
                <li id="myLi"><a href="/home">Home</a></li>
                <li id="myLi"><a href="/dashboard">Dashboard</a></li>
                <li id="myLi"><a href="/shop">Shop</a></li>
                <li id="myLi"><a href="/profile">Profile</a></li>
                <li id="myLi"><a onclick="logOut();">Log out<a></li>
            <% } else { %>
                <li id="myLi"><a href="/login">Login / register</a></li>
            <% } %>
        </ul>
    </nav>
    <% if(userID != -1) { %>
        <div class="tasksUI">
        <button type="button" class="myBtn" onclick="showForm();">Create task</button>
        <form id="newTaskForm" onsubmit="createTask();">
            <h1>Create task</h1>
            <label>Title: 
                <input type="text" id="title" required>
            </label>
            <label>Description: 
                <textarea id="desc" required></textarea>
            </label>
            <label>Type:
                <select id="type" required>
                    <option selected disabled>Select type</option>
                    <option>Daily</option>
                    <option>Weekly</option>
                    <option>One-Time</option>
                </select>
            </label>
            <label>Due date & time:
                <input type="time" id="dueDate">
            </label>
            <button type="button" class="myBtn" onclick="createTask();">Create task</button>
            <button type="button" class="myBtn" onclick="hideForm();">Cancel</button>
        </form>
        </div>
        <ul id="taskList"></ul>
    <% } else { %>
    <% } %>
    <script src="/js/formScripts.js"></script>
    <script src="/js/taskScripts.js"></script>
</body>
</html>