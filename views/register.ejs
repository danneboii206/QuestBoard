<!DOCTYPE html>
<html lang="en">
    <head>
        <!-- Scripts you wanna load in the beginning, meta information, & stylesheets etc -->
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/style/stylesheet.css">
        <title>Register</title>
    </head>
    <body>
        <!-- Everything else. New headers, paragraphs, divs, images, etc. Also scripts for functionality -->
        <div class="reg">
            <form class="regForm" id="regForm" onsubmit="submitReg(event);">
                <label id="regLabel">Registration</label>
                <label for="email">Email:</label>
                <input type="text" id="email" class="myTbx" name="email">
                <label for="user_name">Username:</label>
                <input type="text" id="user_name" class="myTbx" name="user_name">
                <label for="Password">Password:</label>
                <input type="password" id="password" class="myTbx" name="password">
                <div class="buttons">
                    <button type="submit" class="myBtn">Register</button>
                    <a href="/login">
                        <button type="button" class="myBtn"">Login</button>
                    </a>
                </div>
            </form>
        </div>
        <script src="/js/formScript.js"></script>
    <body>
</html>