<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Scripts you wanna load in the beginning, meta information, & stylesheets etc -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style/stylesheet.css">
    <script src="../js/formScript.js"></script>
    <title>Login</title>
</head>
<body>
     <!-- Everything else. New headers, paragraphs, divs, images, etc. Also scripts for functionality -->
    <div class="log">
        <form class="logForm" onsubmit="submitLog(event);">
            <label id="logLabel">Login</label>
            <label for="user_name">Username:</label>
            <input type="text" id="user_name" class="myTbx" name="user_name">
            <label for="Password">Password:</label>
            <input type="password" id="password" class="myTbx" name="password">
            <div class="buttons">
                <button type="submit" class="myBtn">Login</button>
                <a href="/register/">
                    <button type="button" class="myBtn">Register</button>
                </a>
            <div>
        </form>
    </div>
</body>
</html>